@page
@model PlayGames.Areas.Identity.Pages.Account.RegisterModel
@{ ViewData["Title"] = "Create account"; Layout = "/Areas/Identity/Pages/Shared/_AuthLayout.cshtml"; }
<div class="auth-page"><main class="auth-shell">
<section class="hero"><div class="hero-content"><div class="eyebrow"><span class="eyebrow-dot"></span>Join Play Games</div><h1>Build your<br/>library.</h1><p>Create one secure Play Games account for your purchases, digital keys and personal game library.</p><div class="stats"><div class="stat"><strong>1</strong><span>Gaming account</span></div><div class="stat"><strong>Secure</strong><span>Password protection</span></div><div class="stat"><strong>Ready</strong><span>For your library</span></div></div></div></section>
<section class="form-side"><div class="form-wrap"><div class="form-logo">P</div><div class="form-head"><h2>Create account</h2><p>Create your Play Games account and start building your library.</p></div><div asp-validation-summary="ModelOnly"></div><form method="post"><input type="hidden" asp-for="ReturnUrl"/><div class="field"><label asp-for="Input.UserName">USERNAME</label><input class="input" asp-for="Input.UserName" placeholder="Your gaming name" autocomplete="username"/><span class="error" asp-validation-for="Input.UserName"></span></div><div class="field"><label asp-for="Input.Email">EMAIL ADDRESS</label><input class="input" asp-for="Input.Email" placeholder="you@example.com" autocomplete="email"/><span class="error" asp-validation-for="Input.Email"></span></div><div class="field"><label asp-for="Input.Password">PASSWORD</label><input class="input" asp-for="Input.Password" placeholder="Create a strong password" autocomplete="new-password"/><span class="error" asp-validation-for="Input.Password"></span></div><div class="field"><label asp-for="Input.ConfirmPassword">CONFIRM PASSWORD</label><input class="input" asp-for="Input.ConfirmPassword" placeholder="Repeat your password" autocomplete="new-password"/><span class="error" asp-validation-for="Input.ConfirmPassword"></span></div><button type="submit" class="primary-btn">CREATE ACCOUNT</button></form><div class="divider">Already registered?</div><div class="switch">Already have an account? <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Sign in</a></div><div class="security"><b>âœ“</b> Passwords are securely hashed</div></div></section>
</main></div>
