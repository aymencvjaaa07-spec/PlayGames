<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>@ViewData["Title"] Â· Play Games</title>
<style>
:root{--bg:#07111d;--panel:#101c2b;--line:rgba(255,255,255,.08);--text:#f2f6fb;--muted:#8ea0b5;--blue:#1a9fff;--blue2:#52b7ff;--dark:#0877c8;--green:#55d79d;--danger:#ff7890}
*{box-sizing:border-box}html,body{margin:0;min-height:100%}body{min-height:100vh;color:var(--text);font-family:"Segoe UI",Arial,sans-serif;background:radial-gradient(circle at 12% 10%,rgba(26,159,255,.2),transparent 28%),radial-gradient(circle at 88% 82%,rgba(26,115,185,.15),transparent 30%),linear-gradient(145deg,#06101a,#091827 48%,#040a12)}
body:before{content:"";position:fixed;inset:0;pointer-events:none;opacity:.16;background-image:linear-gradient(rgba(255,255,255,.018) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.018) 1px,transparent 1px);background-size:48px 48px}
.topbar{position:fixed;z-index:10;top:0;left:0;right:0;height:70px;padding:0 42px;display:flex;align-items:center;justify-content:space-between;background:rgba(3,9,15,.74);border-bottom:1px solid rgba(255,255,255,.05);backdrop-filter:blur(18px)}
.brand{display:flex;align-items:center;gap:11px;color:#fff;text-decoration:none;font-size:14px;font-weight:800;letter-spacing:.15em}.brand-icon{width:38px;height:38px;display:grid;place-items:center;border-radius:11px;background:linear-gradient(145deg,var(--blue2),var(--dark));box-shadow:0 10px 30px rgba(26,159,255,.3);font-weight:900}.top-text{color:#8799ad;font-size:12px}
.auth-page{min-height:100vh;display:grid;place-items:center;padding:105px 24px 40px}.auth-shell{width:min(1080px,100%);display:grid;grid-template-columns:1.08fr .92fr;overflow:hidden;border:1px solid var(--line);border-radius:24px;background:rgba(6,14,24,.74);box-shadow:0 40px 110px rgba(0,0,0,.46),0 0 80px rgba(26,159,255,.06)}
.hero{position:relative;min-height:640px;display:flex;align-items:flex-end;padding:50px;overflow:hidden;background:linear-gradient(180deg,rgba(4,10,17,.03),rgba(4,10,17,.95)),radial-gradient(circle at 72% 24%,rgba(26,159,255,.35),transparent 31%),linear-gradient(145deg,#103452,#07111d 68%)}
.hero:before{content:"";position:absolute;width:480px;height:480px;right:-120px;top:-100px;border-radius:50%;background:rgba(59,173,255,.1);filter:blur(42px)}.hero:after{content:"PLAY";position:absolute;right:-45px;bottom:-50px;color:rgba(255,255,255,.025);font-size:170px;line-height:.9;font-weight:900;letter-spacing:-.08em}.hero-content{position:relative;z-index:2;max-width:530px}
.eyebrow{display:inline-flex;align-items:center;gap:8px;padding:8px 12px;border-radius:999px;border:1px solid rgba(82,183,255,.18);color:#a9dcff;background:rgba(26,159,255,.08);font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.12em}.eyebrow-dot{width:7px;height:7px;border-radius:50%;background:var(--blue2);box-shadow:0 0 14px rgba(82,183,255,.9)}
.hero h1{margin:21px 0 16px;font-size:clamp(44px,5vw,72px);line-height:.97;letter-spacing:-.055em}.hero p{margin:0;max-width:500px;color:#9eb0c2;font-size:15px;line-height:1.75}.stats{display:flex;gap:34px;margin-top:36px}.stat strong{display:block;margin-bottom:3px;font-size:18px}.stat span{color:#72859a;font-size:11px}
.form-side{padding:48px 44px;display:flex;align-items:center;background:linear-gradient(180deg,rgba(18,34,51,.86),rgba(7,15,25,.97))}.form-wrap{width:100%;max-width:410px;margin:auto}.form-logo{width:52px;height:52px;display:grid;place-items:center;margin-bottom:22px;border-radius:15px;background:linear-gradient(145deg,#59bdff,#0877c8);box-shadow:0 16px 40px rgba(26,159,255,.23);font-size:21px;font-weight:900}.form-head h2{margin:0 0 8px;font-size:30px;letter-spacing:-.035em}.form-head p{margin:0 0 27px;color:var(--muted);font-size:13px;line-height:1.65}.field{margin-bottom:18px}.field label{display:block;margin-bottom:8px;color:#dce5ef;font-size:11px;font-weight:800;letter-spacing:.07em}.input{width:100%;height:53px;padding:0 15px;border:1px solid rgba(255,255,255,.09);outline:none;border-radius:12px;background:rgba(0,0,0,.2);color:#fff;font-size:14px;transition:.18s}.input::placeholder{color:#62778d}.input:focus{border-color:rgba(82,183,255,.78);background:rgba(16,53,80,.38);box-shadow:0 0 0 4px rgba(26,159,255,.1)}
.error{display:block;margin-top:7px;color:var(--danger);font-size:11px}.validation-summary-errors{margin-bottom:17px;padding:12px 14px;border:1px solid rgba(255,120,144,.18);border-radius:11px;background:rgba(255,120,144,.06);color:#ffafbe;font-size:12px}.checkline{display:flex;align-items:center;gap:9px;margin:4px 0 20px;color:#8193a6;font-size:12px}.checkline input{width:15px;height:15px;accent-color:var(--blue)}
.primary-btn{width:100%;height:54px;border:0;border-radius:12px;color:#fff;cursor:pointer;font-size:13px;font-weight:900;letter-spacing:.04em;background:linear-gradient(135deg,#4ab6ff,#0876c8);box-shadow:0 15px 34px rgba(26,159,255,.22);transition:.18s}.primary-btn:hover{transform:translateY(-1px);filter:brightness(1.05);box-shadow:0 20px 43px rgba(26,159,255,.29)}
.divider{display:flex;align-items:center;gap:12px;margin:24px 0;color:#526980;font-size:10px;text-transform:uppercase;letter-spacing:.13em}.divider:before,.divider:after{content:"";height:1px;flex:1;background:rgba(255,255,255,.07)}.switch{color:#74879b;text-align:center;font-size:12px}.switch a{color:#67c0ff;text-decoration:none;font-weight:800}.switch a:hover{text-decoration:underline}.security{display:flex;justify-content:center;align-items:center;gap:7px;margin-top:21px;color:#5e7287;font-size:10px}.security b{color:var(--green)}
@@media (max-width:900px){.auth-shell{grid-template-columns:1fr}.hero{min-height:390px}.form-side{padding:38px 28px}}@@media (max-width:560px){.topbar{padding:0 20px}.top-text{display:none}.auth-page{padding:90px 12px 25px}.hero{min-height:340px;padding:31px 25px}.hero h1{font-size:44px}.form-side{padding:30px 21px}}
</style></head><body>
<header class="topbar"><a href="/" class="brand"><span class="brand-icon">P</span>PLAY GAMES</a><span class="top-text">PREMIUM GAMING STORE</span></header>
@RenderBody()
@await RenderSectionAsync("Scripts", required: false)
</body></html>
