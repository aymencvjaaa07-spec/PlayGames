@model PlayGames.Models.ApplicationUser

@{
    ViewData["Title"] = "My Account";
}

<style>
    .account-page {
        max-width: 1100px;
        margin: 50px auto;
        padding: 0 24px;
    }

    .account-header {
        background: linear-gradient(135deg, #101c32, #0b1425);
        border: 1px solid rgba(70, 150, 255, .18);
        border-radius: 22px;
        padding: 35px;
        margin-bottom: 25px;
        box-shadow: 0 20px 50px rgba(0,0,0,.25);
    }

    .account-badge {
        width: 65px;
        height: 65px;
        border-radius: 18px;
        display: grid;
        place-items: center;
        background: linear-gradient(135deg,#2196ff,#086dcc);
        color: white;
        font-size: 27px;
        font-weight: 900;
        margin-bottom: 20px;
    }

    .account-header h1 {
        margin: 0 0 8px;
        color: white;
        font-size: 32px;
    }

    .account-header p {
        margin: 0;
        color: #8da2bb;
    }

    .account-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;
    }

    .account-card {
        background: #101a2b;
        border: 1px solid rgba(255,255,255,.07);
        border-radius: 18px;
        padding: 25px;
        min-height: 130px;
        transition: .2s ease;
    }

    .account-card:hover {
        transform: translateY(-3px);
        border-color: rgba(45,145,255,.35);
    }

    .account-card .icon {
        font-size: 24px;
        margin-bottom: 15px;
    }

    .account-card h3 {
        color: white;
        margin: 0 0 7px;
        font-size: 17px;
    }

    .account-card span {
        color: #71869e;
        font-size: 13px;
    }

    .account-info {
        margin-top: 25px;
        background: #101a2b;
        border: 1px solid rgba(255,255,255,.07);
        border-radius: 18px;
        padding: 25px;
    }

    .info-row {
        display: flex;
        justify-content: space-between;
        padding: 15px 0;
        border-bottom: 1px solid rgba(255,255,255,.06);
    }

    .info-row:last-child {
        border-bottom: 0;
    }

    .info-label {
        color: #71869e;
    }

    .info-value {
        color: white;
        font-weight: 600;
    }

    .logout {
        margin-top: 25px;
    }

    .logout button {
        border: 0;
        border-radius: 12px;
        padding: 13px 24px;
        background: #172438;
        color: #cbd8e8;
        cursor: pointer;
        font-weight: 700;
    }

    .logout button:hover {
        background: #263950;
    }

    @@@@media(max-width:750px) {
        .account-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="account-page">

    <section class="account-header">
        <div class="account-badge">P</div>

        <h1>Welcome, @Model.UserName</h1>

        <p>Your personal Play Games account</p>
    </section>

    <section class="account-grid">

        <div class="account-card">
            <div class="icon">ðŸŽ®</div>
            <h3>My Library</h3>
            <span>Your games will appear here.</span>
        </div>

        <div class="account-card">
            <div class="icon">ðŸ›’</div>
            <h3>My Purchases</h3>
            <span>Your orders and purchases.</span>
        </div>

        <div class="account-card">
            <div class="icon">ðŸ”‘</div>
            <h3>My Keys</h3>
            <span>Your digital game keys.</span>
        </div>

    </section>

    <section class="account-info">

        <div class="info-row">
            <span class="info-label">Username</span>
            <span class="info-value">@Model.UserName</span>
        </div>

        <div class="info-row">
            <span class="info-label">Email</span>
            <span class="info-value">@Model.Email</span>
        </div>

        <div class="info-row">
            <span class="info-label">Account status</span>
            <span class="info-value">Active</span>
        </div>

        <div class="info-row">
            <span class="info-label">Member since</span>
            <span class="info-value">@Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</span>
        </div>

    </section>

    <form class="logout"
          asp-controller="Account"
          asp-action="Logout"
          method="post">

        @Html.AntiForgeryToken()

        <button type="submit">
            Sign out
        </button>

    </form>

</div>


