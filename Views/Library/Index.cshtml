@model List<PlayGames.Models.Game>

@{
    ViewData["Title"] = "My Library";
}

<div style="max-width:1250px;margin:40px auto;padding:0 24px;color:#fff;">

    <div style="margin-bottom:32px;">
        <h1 style="font-size:36px;margin:0 0 8px;font-weight:900;">
            My Library
        </h1>

        <p style="color:#8da1b6;margin:0;">
            Games saved to your PlayGames account.
        </p>
    </div>

    @if (Model == null || Model.Count == 0)
    {
        <div style="
            padding:70px 30px;
            text-align:center;
            border:1px solid rgba(255,255,255,.08);
            border-radius:20px;
            background:#101e2d;
        ">
            <div style="font-size:50px;margin-bottom:15px;">
                
            </div>

            <h2 style="margin:0 0 10px;">
                Your library is empty
            </h2>

            <p style="color:#8095a9;margin-bottom:25px;">
                Save games from the Game Store and they will appear here.
            </p>

            <a asp-controller="Games"
               asp-action="Index"
               style="
                    display:inline-flex;
                    align-items:center;
                    justify-content:center;
                    height:46px;
                    padding:0 28px;
                    border-radius:10px;
                    background:linear-gradient(135deg,#49b8ff,#0876c8);
                    color:#fff;
                    text-decoration:none;
                    font-size:11px;
                    font-weight:900;
               ">
                BROWSE GAMES
            </a>
        </div>
    }
    else
    {
        <div style="
            display:grid;
            grid-template-columns:repeat(auto-fill,minmax(270px,1fr));
            gap:24px;
        ">

            @foreach (var game in Model)
            {
                var free = game.Price <= 0;

                <div style="
                    overflow:hidden;
                    border:1px solid rgba(255,255,255,.08);
                    border-radius:18px;
                    background:#101e2d;
                    box-shadow:0 12px 35px rgba(0,0,0,.18);
                ">

                    <img src="@game.ImageUrl"
                         alt="@game.Name"
                         style="
                            width:100%;
                            height:220px;
                            object-fit:cover;
                            display:block;
                            background:#08121d;
                         " />

                    <div style="padding:20px;">

                        <h2 style="
                            margin:0 0 8px;
                            font-size:20px;
                            font-weight:800;
                        ">
                            @game.Name
                        </h2>

                        <div style="
                            color:#7f95aa;
                            font-size:12px;
                            margin-bottom:14px;
                        ">
                            @game.Genre
                        </div>

                        <div style="
                            color:#58bdff;
                            font-size:16px;
                            font-weight:800;
                            margin-bottom:16px;
                        ">
                            @(free ? "FREE" : $"{game.DiscountPrice:0.00} DA")
                        </div>

                        @if (!string.IsNullOrWhiteSpace(game.DownloadUrl))
                        {
                            <a href="playgames://install/@game.Id"
                               style="
                                    display:flex;
                                    align-items:center;
                                    justify-content:center;
                                    height:45px;
                                    border-radius:10px;
                                    background:linear-gradient(135deg,#49b8ff,#0876c8);
                                    color:#fff;
                                    text-decoration:none;
                                    font-size:11px;
                                    font-weight:900;
                               ">
                                DOWNLOAD
                            </a>
                        }
                        else
                        {
                            <div style="
                                display:flex;
                                align-items:center;
                                justify-content:center;
                                height:45px;
                                border-radius:10px;
                                background:#18354d;
                                color:#58bdff;
                                font-size:11px;
                                font-weight:900;
                            ">
                                IN YOUR LIBRARY
                            </div>
                        }

                    </div>
                </div>
            }

        </div>
    }

</div>
