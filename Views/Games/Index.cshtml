@model PlayGames.Models.GameStoreViewModel

@{
    ViewData["Title"] = "Games";
}

<div style="max-width:1200px;margin:35px auto;padding:0 24px;color:#fff;">
    <h1 style="font-size:34px;margin-bottom:7px;">Game Store</h1>
    <p style="color:#8da1b6;margin-bottom:28px;">
        Discover games and build your personal library.
    </p>

    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:22px;">
        @foreach (var game in Model.Games)
        {
            var owned = Model.OwnedGameIds.Contains(game.Id);
            var free = game.Price <= 0;

            <div style="overflow:hidden;border:1px solid rgba(255,255,255,.08);border-radius:18px;background:#101e2d;">
                <img src="@game.ImageUrl"
                     alt="@game.Name"
                     style="width:100%;height:220px;object-fit:cover;background:#08121d;" />

                <div style="padding:18px;">
                    <h2 style="margin:0 0 7px;font-size:19px;">@game.Name</h2>

                    <div style="color:#7f95aa;font-size:12px;margin-bottom:15px;">
                        @game.Genre
                    </div>

                    <div style="font-size:19px;font-weight:800;color:#58bdff;margin-bottom:15px;">
                        @(free ? "FREE" : $"{game.DiscountPrice:0.00} DA")
                    </div>

                    @if (owned && !string.IsNullOrWhiteSpace(game.DownloadUrl))
                    {
                        <a href="playgames://install/@game.Id"
                           style="display:flex;align-items:center;justify-content:center;height:45px;border-radius:10px;background:linear-gradient(135deg,#49b8ff,#0876c8);color:#fff;text-decoration:none;font-size:11px;font-weight:900;">
                            DOWNLOAD
                        </a>

                        <div style="text-align:center;color:#71879a;font-size:10px;margin-top:8px;">
                            Added to your library
                        </div>
                    }
                    else if (free)
                    {
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <form asp-controller="Library"
                                  asp-action="Add"
                                  method="post">
                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="gameId"
                                       value="@game.Id" />

                                <button type="submit"
                                        style="width:100%;height:45px;border:0;border-radius:10px;background:linear-gradient(135deg,#49b8ff,#0876c8);color:#fff;font-size:11px;font-weight:900;cursor:pointer;">
                                    GET FOR FREE
                                </button>
                            </form>
                        }
                        else
                        {
                            <a asp-area="Identity"
                               asp-page="/Account/Login"
                               asp-route-returnUrl="/Games"
                               style="display:flex;align-items:center;justify-content:center;height:45px;border-radius:10px;background:linear-gradient(135deg,#49b8ff,#0876c8);color:#fff;text-decoration:none;font-size:11px;font-weight:900;">
                                SIGN IN TO GET
                            </a>
                        }
                    }
                    else
                    {
                        <button disabled
                                style="width:100%;height:45px;border:0;border-radius:10px;background:#233447;color:#70869a;font-size:11px;font-weight:900;">
                            BUY NOW
                        </button>
                    }
                </div>
            </div>
        }
    </div>
</div>

@if (Model.AutoInstallId.HasValue)
{
    <script>
        window.addEventListener("load", function () {
            window.location.href =
                "playgames://install/@Model.AutoInstallId.Value";
        });
    </script>
}
