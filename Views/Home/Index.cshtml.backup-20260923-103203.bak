@{ Layout = null; }
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Play Games Â· Store</title>
<style>
:root{--bg:#07111b;--panel:#102131;--line:rgba(255,255,255,.08);--text:#f4f8fc;--muted:#8fa3b8;--blue:#1a9fff;--blue2:#58bcff;--green:#56dca5}
*{box-sizing:border-box}html,body{margin:0;min-height:100%}body{font-family:"Segoe UI",Arial,sans-serif;color:var(--text);background:radial-gradient(circle at 15% 0%,rgba(26,159,255,.18),transparent 30%),linear-gradient(180deg,#081521,#050d15)}
a{text-decoration:none;color:inherit}
.top{height:70px;position:sticky;top:0;z-index:10;display:flex;align-items:center;gap:35px;padding:0 5%;background:rgba(3,9,15,.88);border-bottom:1px solid var(--line);backdrop-filter:blur(15px)}
.brand{display:flex;align-items:center;gap:10px;font-weight:900;letter-spacing:.13em;font-size:14px}.logo{width:38px;height:38px;display:grid;place-items:center;border-radius:11px;background:linear-gradient(145deg,var(--blue2),#0874c4);box-shadow:0 9px 27px rgba(26,159,255,.25)}
.nav{display:flex;gap:25px;color:#91a5ba;font-size:12px}.nav a:hover{color:#fff}.user{margin-left:auto;color:#a2b3c5;font-size:12px}
.wrap{width:min(1160px,92%);margin:auto;padding:30px 0 70px}.hero{padding:45px;border:1px solid var(--line);border-radius:22px;background:radial-gradient(circle at 78% 18%,rgba(84,188,255,.25),transparent 27%),linear-gradient(135deg,#123652,#081522 70%);box-shadow:0 30px 70px rgba(0,0,0,.28)}
.badge{display:inline-block;padding:7px 11px;border-radius:999px;border:1px solid rgba(88,188,255,.22);background:rgba(26,159,255,.09);color:#b7e3ff;font-size:10px;font-weight:800;letter-spacing:.12em;text-transform:uppercase}.hero h1{margin:15px 0 10px;font-size:clamp(38px,5vw,60px);line-height:1;letter-spacing:-.05em}.hero p{max-width:620px;margin:0;color:#9cafc2;font-size:14px;line-height:1.7}
.head{display:flex;justify-content:space-between;align-items:end;margin:38px 0 17px}.head h2{margin:0;font-size:23px}.head span{color:#708499;font-size:11px}
.game{display:grid;grid-template-columns:1.25fr .9fr;overflow:hidden;border:1px solid var(--line);border-radius:20px;background:linear-gradient(135deg,rgba(17,34,53,.96),rgba(7,15,25,.98))}.cover{min-height:340px;position:relative;display:flex;align-items:flex-end;padding:30px;background:radial-gradient(circle at 72% 25%,rgba(69,194,255,.42),transparent 25%),radial-gradient(circle at 25% 65%,rgba(21,116,211,.33),transparent 30%),linear-gradient(135deg,#0c3551,#07111c 72%)}
.free{position:absolute;right:22px;top:20px;padding:8px 11px;border-radius:9px;background:var(--green);color:#052319;font-size:10px;font-weight:900;letter-spacing:.08em}.cover small{color:#a8d5ee;font-size:10px;letter-spacing:.16em}.cover h3{margin:8px 0 0;font-size:40px;letter-spacing:-.04em}.details{padding:34px;display:flex;flex-direction:column;justify-content:center}.label{color:#6e8499;font-size:10px;font-weight:800;letter-spacing:.13em;text-transform:uppercase}.details h3{margin:10px 0 10px;font-size:30px}.details p{margin:0 0 22px;color:#8fa3b8;font-size:13px;line-height:1.7}.tags{display:flex;gap:9px;flex-wrap:wrap;margin-bottom:22px}.tags span{padding:7px 9px;border:1px solid rgba(255,255,255,.07);border-radius:8px;color:#94a8bb;font-size:10px}.btn{height:50px;display:grid;place-items:center;border-radius:11px;background:linear-gradient(135deg,#53baff,#0877c8);box-shadow:0 13px 30px rgba(26,159,255,.18);font-size:12px;font-weight:900;letter-spacing:.04em}.btn:hover{filter:brightness(1.06);transform:translateY(-1px)}.note{text-align:center;margin-top:11px;color:#60768c;font-size:10px}
@@media(max-width:850px){.nav{display:none}.game{grid-template-columns:1fr}.cover{min-height:250px}.hero{padding:30px}.details{padding:28px}}@@media(max-width:520px){.wrap{width:94%}.hero h1{font-size:41px}.top{padding:0 20px}.user{display:none}}
</style>
</head>
<body>
<header class="top"><a class="brand" href="/"><span class="logo">P</span>PLAY GAMES</a><nav class="nav"><a href="/">STORE</a><a href="#free">FREE GAMES</a><a href="#library">LIBRARY</a></nav></header>
<main class="wrap">
<section class="hero"><span class="badge">Premium Gaming Store</span><h1>Discover your next game.</h1><p>Browse Play Games, collect your digital library and manage your purchases from one secure account.</p></section>
<div id="free" class="head"><h2>Free Game</h2><span>First free title</span></div>
<section class="game">
<div class="cover"><span class="free">FREE</span><div><small>PLAY GAMES Â· FREE EDITION</small><h3>Free Game #1</h3></div></div>
<div class="details"><span class="label">Featured free title</span><h3>Free Game #1</h3><p>This is the first free-game product on Play Games. The title, cover, description and delivery method can be replaced with your real game.</p><div class="tags"><span>FREE</span><span>Digital</span><span>PC</span></div><a class="btn" href="#library">GET FOR FREE</a><div class="note">Available to signed-in Play Games users.</div></div>
</section>
<div id="library" class="head"><h2>Your Library</h2><span>0 games owned</span></div>
</main></body></html>


